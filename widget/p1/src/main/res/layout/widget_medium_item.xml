<?xml version="1.0" encoding="utf-8"?>
<!--
    中号组件里的一条影片：海报 + 标题 + 上映时间。
    整条可点击，跳转到主 App 的该影片详情页（MainActivity 读取 EXTRA_MOVIE_ID）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/widget_item_poster"
        android:layout_width="34dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_poster_placeholder"
        android:contentDescription="@string/widget_poster_desc"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_item_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>