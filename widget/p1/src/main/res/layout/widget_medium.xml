<?xml version="1.0" encoding="utf-8"?>
<!--
    中号组件（4×3）：标题栏（标题 + 数量 + 刷新）+ 3 条即将上映 + 底部入口。
    3 条条目由代码用 RemoteViews.addView 动态添加，空态时显示中间的占位块。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_medium"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_medium_title"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_medium_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/widget_medium_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_refresh"
            android:padding="2dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <!-- 3 条影片（代码动态填充） -->
    <LinearLayout
        android:id="@+id/widget_medium_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <!-- 空态：主应用无数据 / 未安装时显示 -->
    <LinearLayout
        android:id="@+id/widget_medium_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_medium_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/widget_empty_title"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_medium_empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/widget_empty_hint"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 底部提示：填满 4×3 的空白，并作为进入 App 的第二个入口 -->
    <TextView
        android:id="@+id/widget_medium_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:text="@string/widget_medium_footer"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp" />
</LinearLayout>